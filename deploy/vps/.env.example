# Wonkru MDM deployment environment (Docker Compose).
# Generate .env with ./init-env.sh [HOST] [ACME_EMAIL].
# Preserve existing secrets when updating a deployment: changing peppers or
# signing keys invalidates encrypted records or signed download links.
# Default mode: one host, HTTP, separate API and panel ports.

# Required by the ready-image override. Use a specific published vX.Y.Z tag.
WONKRU_IMAGE=
# Bind address for the ready-image HTTP override.
HTTP_BIND_IP=127.0.0.1

# Public endpoints. The agent server URL must match API_PUBLIC_*.
# Caddy serves downloads and CA files on the API origin.
API_PUBLIC_SCHEME=http
API_PUBLIC_HOST=CHANGE_ME
API_PUBLIC_PORT=8080

WEB_PUBLIC_SCHEME=http
WEB_PUBLIC_HOST=CHANGE_ME
WEB_PUBLIC_PORT=8082

# Panel origin for credentialed requests; must match WEB_PUBLIC_*.
PANEL_ORIGIN=http://CHANGE_ME:8082
# Base URL for generated links; must match API_PUBLIC_*.
APP_URL=http://CHANGE_ME:8080

# Caddy site addresses use container ports; API_PORT/WEB_PORT set host ports.
API_SITE=http://:8080
WEB_SITE=http://:8082
# Optional API/download bridge, e.g. http://:80. Its default port is not published.
BRIDGE_SITE=
# TLS: empty = HTTP or automatic ACME for HTTPS domains;
#      "tls internal" = local CA;
#      "tls /certs/tls.crt /certs/tls.key" = supplied certificate.
CADDY_TLS=
# Optional HTTP listener that serves only /downloads/local-ca.
CA_BOOTSTRAP_SITE=
# ACME account email for domain-based HTTPS.
ACME_EMAIL=

# Published host ports must be distinct.
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8080
WEB_PORT=8082

# Auth cookie: true for HTTPS, false for HTTP.
AUTH_COOKIE_SECURE=false

# Application
APP_NAME=Wonkru MDM

# ─────────────────────────────────────────────────────────────────────────────
# Deployment examples
#
# A) SINGLE HOST + HTTP + PORTS (default)
#    API_PUBLIC_SCHEME=http  API_PUBLIC_HOST=192.168.1.5  API_PUBLIC_PORT=8080
#    WEB_PUBLIC_SCHEME=http  WEB_PUBLIC_HOST=192.168.1.5  WEB_PUBLIC_PORT=8082
#    PANEL_ORIGIN=http://192.168.1.5:8082   APP_URL=http://192.168.1.5:8080
#    API_SITE=http://:8080  WEB_SITE=http://:8082  BRIDGE_SITE=  CADDY_TLS=
#    HTTP_PORT=80  HTTPS_PORT=443  API_PORT=8080  WEB_PORT=8082
#    AUTH_COOKIE_SECURE=false
#
# B) SINGLE HOST + HTTPS + PORTS (local CA)
#    API_PUBLIC_SCHEME=https  API_PUBLIC_HOST=192.168.1.5  API_PUBLIC_PORT=8443
#    WEB_PUBLIC_SCHEME=https  WEB_PUBLIC_HOST=192.168.1.5  WEB_PUBLIC_PORT=8444
#    PANEL_ORIGIN=https://192.168.1.5:8444  APP_URL=https://192.168.1.5:8443
#    API_SITE=https://:8080  WEB_SITE=https://:8082  CADDY_TLS="tls internal"
#    API_PORT=8443  WEB_PORT=8444   (host → container 8080/8082)
#    AUTH_COOKIE_SECURE=true
#
# C) DOMAIN + HTTPS (Let's Encrypt)
#    API_PUBLIC_SCHEME=https  API_PUBLIC_HOST=api.example.com  API_PUBLIC_PORT=443
#    WEB_PUBLIC_SCHEME=https  WEB_PUBLIC_HOST=app.example.com  WEB_PUBLIC_PORT=443
#    PANEL_ORIGIN=https://app.example.com  APP_URL=https://api.example.com
#    API_SITE=https://api.example.com  WEB_SITE=https://app.example.com  CADDY_TLS=
#    ACME_EMAIL=ops@example.com  HTTP_PORT=80  HTTPS_PORT=443
#    AUTH_COOKIE_SECURE=true
#
# D) DOMAIN + HTTP
#    API_PUBLIC_SCHEME=http  API_PUBLIC_HOST=api.example.com  API_PUBLIC_PORT=80
#    WEB_PUBLIC_SCHEME=http  WEB_PUBLIC_HOST=app.example.com  WEB_PUBLIC_PORT=80
#    PANEL_ORIGIN=http://app.example.com  APP_URL=http://api.example.com
#    API_SITE=http://api.example.com  WEB_SITE=http://app.example.com  CADDY_TLS=
#    HTTP_PORT=80  AUTH_COOKIE_SECURE=false
#
# ─────────────────────────────────────────────────────────────────────────────

# Secrets generated by init-env.sh
DB_PASSWORD=
SERVICE_SECRET=
EMAIL_SECRET_HASH_PEPPER=
JWT_HMAC_SHA512_PRIVATE_KEY=
JWT_REFRESH_TOKEN_HASH_PEPPER=
STORAGE_SIGNING_KEY=
PASSWORD_HASH_PEPPER=
STARTER_ADMIN_PASSWORD=
